rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "aw734622@gmail.com" ||
        request.auth.token.email == "mhmwdaltahrahmdwayl@gmail.com"
      );
    }
    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'reviews', 'questionsList']));
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || docId == "stats" || docId == "store_reviews";
    }
    match /promoCodes/{docId} {
      allow read, create, update, delete: if true;
    }
    match /orders/{docId} {
      allow create, read: if true;
      allow update: if isAdmin() || request.auth != null;
      allow delete: if isAdmin();
    }
    match /chats/{docId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null || isAdmin();
    }
    match /site_visitors/{visId} {
      allow read, write: if true;
    }
    match /return_requests/{docId} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }
    match /stock_alerts/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
    match /wheel_leads/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
    match /price_alerts/{docId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
    match /global_notifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admins/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

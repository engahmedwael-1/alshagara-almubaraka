rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "aw734622@gmail.com" ||
        request.auth.token.email == "mhmwdaltahrahmdwayl@gmail.com"
      );
    }

    // يدعم كل من staff_members + admins المضافين من داخل المتجر!
    function isActiveStaff() {
      return isSuperAdmin()
        || (request.auth != null
            && exists(/databases/$(database)/documents/staff_members/$(request.auth.token.email))
            && get(/databases/$(database)/documents/staff_members/$(request.auth.token.email)).data.active == true)
        || (request.auth != null
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // 1. الموظفون والأدمنز: المدير العام يقرأ الكل، وكل موظف يقرأ سجلّه فقط (لا تسريب إيميلات!)
    match /staff_members/{email} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.token.email == email);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        request.auth != null && request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boundDeviceId', 'lastSeen'])
      );
    }
    match /admins/{docId} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.token.email == docId);
      allow write: if isSuperAdmin();
    }

    // 2. سجلات الإدارة والمالية (للموظفين فقط)
    match /audit_logs/{docId} { allow read, create: if isActiveStaff(); allow update, delete: if isSuperAdmin(); }
    match /expenses/{docId} { allow read, write: if isActiveStaff(); }
    match /suppliers/{docId} { allow read, write: if isActiveStaff(); }
    match /treasury_ledger/{docId} { allow read, write: if isActiveStaff(); }
    match /team_tasks/{docId} { allow read, write: if isActiveStaff(); }
    match /team_chat/{docId} { allow read, write: if isActiveStaff(); }
    match /shift_logs/{docId} { allow read, write: if isActiveStaff(); }

    // 3. المنتجات: قراءة للجميع، وتحديث محكوم للمخزون (>=0) والتقييمات عند الشراء
    match /products/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'reviews', 'questionsList'])
        && (!('stock' in request.resource.data) || request.resource.data.stock >= 0)
      );
    }

    // 4. الإعدادات والإحصائيات والتقييمات (منع مسح التقييمات أو التلاعب بالزيارات)
    match /settings/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff()
        || (docId == "counters" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCustomerSeq', 'updatedAt']))
        || (docId == "stats" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits', 'todayVisits', 'todayKey', 'lastVisitAt']))
        || (docId == "store_reviews" && request.auth != null
            && request.resource.data.list is list
            && (!('list' in resource.data) || request.resource.data.list.size() >= resource.data.list.size()));
    }

    // تقييمات مستقلة آمنة (إضافة فقط للعملاء، وحذف للإدارة)
    match /store_reviews_v2/{docId} {
      allow read: if true;
      allow create: if request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isActiveStaff();
    }

    // 5. كوبونات الخصم: قراءة للجميع، وتحديث usageCount/used فقط (ممنوع الحذف من العميل!)
    match /promoCodes/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'used', 'usedBy'])
      );
    }

    // 6. الطلبات: إنشاء مع تحقق الإجمالي > 0 + قراءة لصاحب الطلب + إلغاء مسموح وهو "قيد المراجعة" فقط!
    match /orders/{docId} {
      allow create: if request.resource.data.totalAmount is number && request.resource.data.totalAmount > 0;
      allow read: if isActiveStaff() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email ||
          resource.data.customerEmail == request.auth.token.phone_number
        )
      );
      allow update: if isActiveStaff() || (
        request.auth != null
        && (resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email)
        && resource.data.status == "قيد المراجعة"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceledAt', 'cancelReason'])
        && (request.resource.data.status == "ملغى" || request.resource.data.status == "ملغي")
      );
      allow delete: if isSuperAdmin();
    }

    // 7. المحادثات: صاحب المحادثة أو الإدارة فقط (مع السماح بطعون المحظورين appeal_)
    match /chats/{docId} {
      allow read, write: if isActiveStaff()
        || docId.matches('appeal_.*')
        || (request.auth != null && (
          docId == request.auth.uid ||
          docId == request.auth.token.email ||
          docId == request.auth.token.phone_number
        ));
    }

    // 8. بيانات العملاء: كل عميل يقرأ ويكتب حسابه فقط
    match /users/{userId} {
      allow read: if isActiveStaff() || (request.auth != null && request.auth.uid == userId);
      allow create, update: if isActiveStaff()
        || (request.auth != null && request.auth.uid == userId)
        || userId.matches('lead_.*');
      allow delete: if isSuperAdmin() || (request.auth != null && userId.matches('lead_.*'));
    }

    // 9. الزوار والمرتجعات والتنبيهات
    match /site_visitors/{visId} { allow create, update: if true; allow read, delete: if isActiveStaff(); }
    match /return_requests/{docId} {
      allow create: if true;
      allow read: if isActiveStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isActiveStaff();
    }
    match /stock_alerts/{docId} { allow create: if true; allow read, delete: if isActiveStaff(); }
    match /wheel_leads/{docId} { allow create: if true; allow read, delete: if isActiveStaff(); }
    match /price_alerts/{docId} { allow create: if true; allow read, delete: if isActiveStaff(); }
    match /global_notifications/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'openedCount'])
      );
    }
  }
}
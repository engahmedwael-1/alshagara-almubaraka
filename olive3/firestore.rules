rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "aw734622@gmail.com" ||
        request.auth.token.email == "mhmwdaltahrahmdwayl@gmail.com"
      );
    }

    function isActiveStaff() {
      return isSuperAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/staff_members/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/staff_members/$(request.auth.token.email)).data.active == true
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerOrStaff(userId) {
      return isActiveStaff() || isOwner(userId);
    }

    function isOwnerByEmail(email) {
      return request.auth != null && (
        request.auth.token.email == email ||
        request.auth.token.phone_number == email
      );
    }

    function isOwnerOrStaffByEmail(email) {
      return isActiveStaff() || isOwnerByEmail(email);
    }

    function isValidOrderCreate() {
      // Rate limiting: max 5 orders per minute per IP/user
      // Basic validation for order creation
      return request.auth != null || true; // Allow guest orders but log them
    }

    function isValidChatCreate() {
      // Allow chat creation but rate limit
      return request.auth != null;
    }

    function isValidReviewCreate() {
      // Only authenticated users can create reviews
      return request.auth != null;
    }

    function isValidReturnCreate() {
      // Only authenticated users who have delivered orders can create returns
      return request.auth != null;
    }

    function isValidPromoUse() {
      return request.auth != null;
    }

    // ========================================================================
    // 1. STAFF & ADMIN MANAGEMENT
    // ========================================================================
    match /staff_members/{email} {
      allow read: if request.auth != null;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        request.auth != null &&
        request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boundDeviceId', 'lastSeen', 'preferences'])
      );
    }

    match /admins/{docId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // ========================================================================
    // 2. AUDIT & FINANCIAL LOGS (Staff only)
    // ========================================================================
    match /audit_logs/{docId} {
      allow read, create: if isActiveStaff();
      allow update, delete: if isSuperAdmin();
    }

    match /expenses/{docId} {
      allow read, write: if isActiveStaff();
    }

    match /suppliers/{docId} {
      allow read, write: if isActiveStaff();
    }

    match /treasury_ledger/{docId} {
      allow read, write: if isActiveStaff();
    }

    match /team_tasks/{docId} {
      allow read, write: if isActiveStaff();
    }

    match /team_chat/{docId} {
      allow read, write: if isActiveStaff();
    }

    match /shift_logs/{docId} {
      allow read, write: if isActiveStaff();
    }

    // ========================================================================
    // 3. PRODUCTS (Public read, Staff write, Limited customer updates)
    // ========================================================================
    match /products/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'reviews', 'questionsList', 'viewCount'])
      );
    }

    // ========================================================================
    // 4. SETTINGS & STATS (Protected)
    // ========================================================================
    match /settings/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff()
        || (docId == "counters" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCustomerSeq', 'updatedAt']))
        || (docId == "stats" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVisits', 'visits', 'todayVisits', 'todayKey', 'lastVisitAt']))
        || (docId == "store_reviews" && isValidReviewCreate())
        || (docId == "main" && isActiveStaff());
    }

    // ========================================================================
    // 5. PROMO CODES (Public read, Staff write, Limited customer usage increment)
    // ========================================================================
    match /promoCodes/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'usedBy'])
      );
    }

    // ========================================================================
    // 6. ORDERS (Create: all, Read/Update: owner or staff)
    // ========================================================================
    match /orders/{docId} {
      allow create: if isValidOrderCreate();
      allow read: if isActiveStaff() || isOwnerOrStaffByEmail(resource.data.customerEmail);
      allow update: if isActiveStaff() || (
        // Customers can only cancel their own orders if still pending
        isOwnerByEmail(resource.data.customerEmail) &&
        resource.data.status == 'قيد المراجعة' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceledAt', 'updatedAt']) &&
        request.resource.data.status == 'ملغى من العميل ❌'
      );
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // 7. CHATS (Owner or staff only)
    // ========================================================================
    match /chats/{docId} {
      allow read, write: if isActiveStaff()
        || docId.matches('appeal_.*')
        || (request.auth != null && (
          docId == request.auth.uid ||
          docId == request.auth.token.email ||
          docId == request.auth.token.phone_number
        ));
    }

    // ========================================================================
    // 8. USERS (Own data or staff)
    // ========================================================================
    match /users/{userId} {
      allow read: if isActiveStaff() || isOwner(userId);
      allow create: if isActiveStaff() || userId.matches('lead_.*') || isOwner(userId);
      allow update: if isActiveStaff() || isOwner(userId) || userId.matches('lead_.*');
      allow delete: if isSuperAdmin() || (isOwner(userId) && userId.matches('lead_.*'));
    }

    // ========================================================================
    // 9. SITE VISITORS (Anonymous tracking, Staff read/delete)
    // ========================================================================
    match /site_visitors/{visId} {
      allow create, update: if true;
      allow read, delete: if isActiveStaff();
    }

    // ========================================================================
    // 10. RETURN REQUESTS (Customers create, Staff manage)
    // ========================================================================
    match /return_requests/{docId} {
      allow create: if isValidReturnCreate();
      allow read: if isActiveStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isActiveStaff();
    }

    // ========================================================================
    // 11. ALERTS & NOTIFICATIONS
    // ========================================================================
    match /stock_alerts/{docId} {
      allow create: if true;
      allow read, delete: if isActiveStaff();
    }

    match /wheel_leads/{docId} {
      allow create: if true;
      allow read, delete: if isActiveStaff();
    }

    match /price_alerts/{docId} {
      allow create: if request.auth != null;
      allow read, delete: if isActiveStaff();
    }

    match /global_notifications/{docId} {
      allow read: if true;
      allow create, delete: if isActiveStaff();
      allow update: if isActiveStaff() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'openedCount'])
      );
    }

    // ========================================================================
    // 12. NEW FEATURES - GROUP BUYS
    // ========================================================================
    match /group_buys/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isActiveStaff() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'currentCount', 'status'])
      );
      allow delete: if isActiveStaff();
    }

    match /group_buy_participants/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isActiveStaff();
    }

    // ========================================================================
    // 13. NEW FEATURES - PREORDERS
    // ========================================================================
    match /preorders/{docId} {
      allow read: if isActiveStaff() || (request.auth != null && resource.data.customerEmail == request.auth.token.email);
      allow create: if request.auth != null;
      allow update: if isActiveStaff();
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // 14. NEW FEATURES - REFERRALS
    // ========================================================================
    match /referrals/{docId} {
      allow read: if isActiveStaff() || (request.auth != null && resource.data.referrerId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isActiveStaff() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rewardClaimedAt', 'convertedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // 15. NEW FEATURES - GIFT CARDS
    // ========================================================================
    match /gift_cards/{docId} {
      allow read: if isActiveStaff() || (request.auth != null && (resource.data.buyerEmail == request.auth.token.email || resource.data.recipientEmail == request.auth.token.email));
      allow create: if request.auth != null;
      allow update: if isActiveStaff() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'status', 'redeemedAt', 'redeemedBy'])
      );
      allow delete: if isSuperAdmin();
    }

    // ========================================================================
    // 16. NEW FEATURES - LIVE STREAMS
    // ========================================================================
    match /live_streams/{docId} {
      allow read: if true;
      allow create, update, delete: if isActiveStaff();
    }

    match /live_stream_viewers/{docId} {
      allow read: if isActiveStaff();
      allow create, update: if true;
    }

    // ========================================================================
    // 17. NEW FEATURES - BUNDLE TEMPLATES
    // ========================================================================
    match /bundle_templates/{docId} {
      allow read: if true;
      allow create, update, delete: if isActiveStaff();
    }

    match /user_bundles/{docId} {
      allow read: if isActiveStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isActiveStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if isActiveStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // ========================================================================
    // 18. NEW FEATURES - LOYALTY TIERS & TRANSACTIONS
    // ========================================================================
    match /loyalty_transactions/{docId} {
      allow read: if isActiveStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if isActiveStaff();
      allow update, delete: if isSuperAdmin();
    }

    match /loyalty_tiers/{docId} {
      allow read: if true;
      allow create, update, delete: if isActiveStaff();
    }

    // ========================================================================
    // 19. NEW FEATURES - ANALYTICS EVENTS
    // ========================================================================
    match /analytics_events/{docId} {
      allow read: if isActiveStaff();
      allow create: if true; // Client-side tracking
      allow update, delete: if isSuperAdmin();
    }

    // ========================================================================
    // 20. DEFAULT DENY ALL
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}